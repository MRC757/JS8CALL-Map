{
  "name": "js8call-map",
  "version": "1.0.0",
  "description": "Interactive Maidenhead grid map for JS8CALL operator locations",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "package": "pkg . --targets node18-win-x64 --output dist/js8call-map.exe"
  },
  "pkg": {
    "assets": [
      "public/index.html",
      "public/app.js",
      "public/style.css",
      "node_modules/leaflet/dist/**",
      "node_modules/world-atlas/**",
      "node_modules/topojson-client/dist/**"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "leaflet": "^1.9.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
